{
  "schema": "bashcut-batch/1",
  "inputs": [
    "."
  ],
  "projectsFolder": "bashcut-batch/projects",
  "outputsFolder": "bashcut-batch/exports",
  "onFailure": "skip",
  "name": "captions-draft",
  "description": "Captions draft for a folder: captions grouped from the words at 20 characters a second or less, reviewed, an SRT, a clean word style and a YouTube preview per clip",
  "concurrency": 2,
  "steps": [
    {
      "label": "transcribe",
      "command": "sequence.transcribe",
      "params": {
        "language": "auto"
      },
      "timeoutSeconds": 3600
    },
    {
      "label": "readable captions from the words",
      "command": "bashcut.captions.create",
      "params": {
        "maxChars": 42,
        "lines": 2,
        "maxCps": 20
      }
    },
    {
      "label": "review the captions",
      "command": "bashcut.review.run",
      "params": {
        "profile": "youtube",
        "checks": [
          "captions"
        ]
      }
    },
    {
      "label": "SRT",
      "command": "captions.export",
      "params": {
        "path": "{outputs}/{name}.srt",
        "track": "C1"
      }
    },
    {
      "label": "clean word style",
      "command": "bashcut.captions.wordStyle",
      "params": {
        "style": {
          "preset": "clean"
        }
      }
    }
  ],
  "outputs": [
    {
      "name": "{name}-captions-preview.mp4",
      "profile": "youtube"
    }
  ]
}
