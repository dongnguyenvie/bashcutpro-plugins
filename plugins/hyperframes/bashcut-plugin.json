{
  "schema": "bashcut-plugin/1",
  "id": "bashcut.hyperframes",
  "name": "HyperFrames Graphics",
  "version": "0.1.8",
  "summary": "Animated graphics written as HTML/CSS + GSAP (counters, charts, cards, diagrams, maps, kinetic type), rendered with HyperFrames in headless Chrome to a PNG sequence or ProRes 4444 with alpha, imported and placed over the picture.",
  "publisher": "dongnguyenvie",
  "license": "MIT",
  "homepage": "https://github.com/dongnguyenvie/bashcutpro-plugins/tree/main/plugins/hyperframes",
  "category": "graphics",
  "platforms": ["macos", "windows", "linux"],
  "runtime": {
    "type": "python",
    "version": ">=3.9",
    "packages": ["npm:hyperframes@0.8.140", "npm:gsap@3.14.2", "npm:katex@0.16.47", "npm:lottie-web@5.13.0"],
    "note": "The plugin is Python 3.9+ standard library. Rendering needs Node.js 22.19+ (found on this computer, never installed by the plugin), the npm packages above (`setup` runs `npm ci` from the pinned lock file, about 135 MB) and Chrome headless shell (`setup`, about 210 MB). FFmpeg is needed only for --format mov."
  },
  "entry": {
    "command": ["python3", "plugin.py"],
    "windows": ["py", "-3", "plugin.py"]
  },
  "connect": {
    "project": ["--project", "{project}"],
    "bridge": ["--bridge", "{address}"],
    "cli": ["--cli", "{cli}"]
  },
  "output": "bashcut-result/1",
  "app": {
    "minVersion": "0.9.0",
    "connections": ["mcp-headless", "mcp-bridge"],
    "tools": ["media_import", "command_run", "sequence_inspect"],
    "commands": ["file.importImageSequence", "file.import", "sequence.addTracks", "timeline.place", "media.replaceFootage", "file.save"],
    "effects": []
  },
  "settings": [
    {
      "id": "node",
      "title": "Node.js",
      "type": "path",
      "default": "",
      "env": ["BASHCUT_HYPERFRAMES_NODE"],
      "flag": "--node",
      "optional": true,
      "help": "Node.js 22.19 or newer. Empty: the one found on this computer (PATH, Homebrew, nvm, Volta, Program Files).",
      "i18n": {"vi": {"title": "Node.js", "help": "Node.js 22.19 trở lên. Để trống: dùng bản tìm thấy trên máy này (PATH, Homebrew, nvm, Volta, Program Files)."}}
    },
    {
      "id": "chrome",
      "title": "Chrome headless shell",
      "type": "path",
      "default": "",
      "env": ["BASHCUT_HYPERFRAMES_CHROME", "HYPERFRAMES_BROWSER_PATH"],
      "flag": "--chrome",
      "optional": true,
      "help": "The browser HyperFrames renders with. Empty: the one that Install HyperFrames and Chrome put in place.",
      "i18n": {"vi": {"title": "Chrome headless shell", "help": "Trình duyệt HyperFrames dùng để dựng. Để trống: dùng bản do Cài HyperFrames và Chrome đặt sẵn."}}
    },
    {
      "id": "ffmpeg",
      "title": "FFmpeg",
      "type": "path",
      "default": "",
      "env": ["BASHCUT_HYPERFRAMES_FFMPEG"],
      "flag": "--ffmpeg",
      "optional": true,
      "help": "Only needed for mov output (ProRes 4444 with alpha). Empty: the one found on this computer.",
      "i18n": {"vi": {"title": "FFmpeg", "help": "Chỉ cần khi xuất mov (ProRes 4444 có alpha). Để trống: dùng bản tìm thấy trên máy này."}}
    },
    {
      "id": "format",
      "title": "Output",
      "type": "enum",
      "choices": ["png", "mov"],
      "default": "png",
      "env": ["BASHCUT_HYPERFRAMES_FORMAT"],
      "flag": "--format",
      "help": "png: a sequence of PNG pictures with transparency (no FFmpeg needed); mov: one ProRes 4444 movie with alpha (needs FFmpeg).",
      "i18n": {"vi": {"title": "Đầu ra", "help": "png: chuỗi ảnh PNG có nền trong suốt (không cần FFmpeg); mov: một tệp phim ProRes 4444 có alpha (cần FFmpeg).", "choices": {"png": "Chuỗi PNG", "mov": "ProRes 4444 (.mov)"}}}
    }
  ],
  "actions": [
    {
      "id": "check",
      "title": "Check the HyperFrames install",
      "args": ["check"],
      "needs": "none",
      "edits": false,
      "params": [],
      "i18n": {"vi": {"title": "Kiểm tra bản cài HyperFrames"}}
    },
    {
      "id": "setup",
      "title": "Install HyperFrames and Chrome…",
      "args": ["setup"],
      "needs": "none",
      "edits": false,
      "params": [
        {"id": "dryRun", "title": "Only show the steps", "flag": "--dry-run", "type": "bool", "default": false, "i18n": {"vi": {"title": "Chỉ hiện các bước"}}}
      ],
      "i18n": {"vi": {"title": "Cài HyperFrames và Chrome…"}}
    },
    {
      "id": "examples",
      "title": "List the example graphics",
      "args": ["examples"],
      "needs": "none",
      "edits": false,
      "params": [],
      "i18n": {"vi": {"title": "Liệt kê đồ họa mẫu"}}
    },
    {
      "id": "hf",
      "title": "HyperFrames CLI (catalog, add, lint, snapshot, docs)",
      "args": ["hf"],
      "needs": "none",
      "edits": false,
      "params": [],
      "i18n": {"vi": {"title": "Dòng lệnh HyperFrames (catalog, add, lint, snapshot, docs)"}}
    },
    {
      "id": "osm-map",
      "title": "OpenStreetMap tiles and a route",
      "args": ["osm-map"],
      "needs": "none",
      "edits": false,
      "params": [],
      "i18n": {"vi": {"title": "Ô bản đồ OpenStreetMap và lộ trình"}}
    },
    {
      "id": "render",
      "title": "Render a graphic",
      "args": ["render"],
      "needs": "none",
      "edits": false,
      "params": [
        {"id": "set", "title": "Values (name=value)", "flag": "--set", "type": "string", "optional": true, "i18n": {"vi": {"title": "Giá trị (tên=giá trị)"}}},
        {"id": "variables", "title": "Variables (JSON)", "flag": "--variables", "type": "string", "optional": true, "i18n": {"vi": {"title": "Biến (JSON)"}}},
        {"id": "brand", "title": "Brand file", "flag": "--brand", "type": "path", "optional": true, "i18n": {"vi": {"title": "Tệp thương hiệu"}}},
        {"id": "fps", "title": "Frame rate", "flag": "--fps", "type": "integer", "minimum": 1, "maximum": 120, "default": 30, "i18n": {"vi": {"title": "Tốc độ khung hình"}}},
        {"id": "duration", "title": "Length (s)", "flag": "--duration", "type": "number", "optional": true, "i18n": {"vi": {"title": "Độ dài (giây)"}}},
        {"id": "draft", "title": "Draft (15 fps, faster)", "flag": "--draft", "type": "bool", "default": false, "i18n": {"vi": {"title": "Bản nháp (15 fps, nhanh hơn)"}}},
        {"id": "name", "title": "Output name", "flag": "--name", "type": "string", "optional": true, "i18n": {"vi": {"title": "Tên đầu ra"}}},
        {"id": "out", "title": "Renders folder", "flag": "--out", "type": "path", "optional": true, "i18n": {"vi": {"title": "Thư mục bản dựng"}}},
        {"id": "strict", "title": "Refuse when lint finds errors", "flag": "--strict", "type": "bool", "default": false, "i18n": {"vi": {"title": "Dừng khi lint tìm thấy lỗi"}}},
        {"id": "snapshot", "title": "Snapshot at seconds only", "flag": "--snapshot", "type": "string", "optional": true, "i18n": {"vi": {"title": "Chỉ chụp ảnh tại các giây"}}}
      ],
      "i18n": {"vi": {"title": "Dựng một đồ họa"}}
    },
    {
      "id": "place",
      "title": "Graphic over the picture…",
      "args": ["place"],
      "needs": "project",
      "edits": true,
      "params": [
        {"id": "seconds", "title": "Start (s)", "flag": "--seconds", "type": "number", "optional": true, "i18n": {"vi": {"title": "Bắt đầu (giây)"}}},
        {"id": "frame", "title": "Start (frame)", "flag": "--frame", "type": "integer", "optional": true, "i18n": {"vi": {"title": "Bắt đầu (khung hình)"}}},
        {"id": "track", "title": "Track", "flag": "--track", "type": "string", "default": "V2", "i18n": {"vi": {"title": "Track"}}},
        {"id": "set", "title": "Values (name=value)", "flag": "--set", "type": "string", "optional": true, "i18n": {"vi": {"title": "Giá trị (tên=giá trị)"}}},
        {"id": "variables", "title": "Variables (JSON)", "flag": "--variables", "type": "string", "optional": true, "i18n": {"vi": {"title": "Biến (JSON)"}}},
        {"id": "brand", "title": "Brand file", "flag": "--brand", "type": "path", "optional": true, "i18n": {"vi": {"title": "Tệp thương hiệu"}}},
        {"id": "fps", "title": "Frame rate", "flag": "--fps", "type": "integer", "optional": true, "i18n": {"vi": {"title": "Tốc độ khung hình"}}},
        {"id": "duration", "title": "Length (s)", "flag": "--duration", "type": "number", "optional": true, "i18n": {"vi": {"title": "Độ dài (giây)"}}},
        {"id": "draft", "title": "Draft (15 fps, faster)", "flag": "--draft", "type": "bool", "default": false, "i18n": {"vi": {"title": "Bản nháp (15 fps, nhanh hơn)"}}},
        {"id": "out", "title": "Renders folder", "flag": "--out", "type": "path", "optional": true, "i18n": {"vi": {"title": "Thư mục bản dựng"}}},
        {"id": "strict", "title": "Refuse when lint finds errors", "flag": "--strict", "type": "bool", "default": false, "i18n": {"vi": {"title": "Dừng khi lint tìm thấy lỗi"}}}
      ],
      "i18n": {"vi": {"title": "Đồ họa đè lên hình…"}}
    },
    {
      "id": "rerender",
      "title": "Change a placed graphic",
      "args": ["rerender"],
      "needs": "project",
      "edits": true,
      "params": [
        {"id": "set", "title": "Values (name=value)", "flag": "--set", "type": "string", "optional": true, "i18n": {"vi": {"title": "Giá trị (tên=giá trị)"}}},
        {"id": "unset", "title": "Drop recorded values", "flag": "--unset", "type": "string", "optional": true, "i18n": {"vi": {"title": "Bỏ các giá trị đã lưu"}}},
        {"id": "duration", "title": "Length (s)", "flag": "--duration", "type": "number", "optional": true, "i18n": {"vi": {"title": "Độ dài (giây)"}}},
        {"id": "final", "title": "Full quality", "flag": "--final", "type": "bool", "default": false, "i18n": {"vi": {"title": "Chất lượng đầy đủ"}}}
      ],
      "i18n": {"vi": {"title": "Sửa đồ họa đã đặt"}}
    },
    {
      "id": "finalise",
      "title": "Render drafts at full quality",
      "args": ["finalise"],
      "needs": "project",
      "edits": true,
      "params": [
        {"id": "out", "title": "Renders folder", "flag": "--out", "type": "path", "optional": true, "i18n": {"vi": {"title": "Thư mục bản dựng"}}}
      ],
      "i18n": {"vi": {"title": "Dựng lại bản nháp ở chất lượng đầy đủ"}}
    }
  ],
  "skills": ["skills/hyperframes/SKILL.md"],
  "i18n": {"vi": {"name": "Đồ họa HyperFrames", "summary": "Đồ họa động viết bằng HTML/CSS + GSAP (bộ đếm, biểu đồ, thẻ, sơ đồ, bản đồ, chữ chuyển động), dựng bằng HyperFrames trong Chrome chạy ẩn thành chuỗi PNG hoặc ProRes 4444 có alpha, rồi nhập và đặt lên trên hình."}}
}
