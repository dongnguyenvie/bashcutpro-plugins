{
  "schema": "bashcut-plugin/1",
  "id": "bashcut.align",
  "name": "Align Script to Speech",
  "version": "0.1.14",
  "summary": "Put a known script, subtitle file or translation on the speech with word timing (better captions than transcription alone), report low-confidence spans, and check a script's lines against the time they have.",
  "publisher": "dongnguyenvie",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/dongnguyenvie/bashcutpro-plugins/tree/main/plugins/align",
  "category": "captions",
  "platforms": ["macos", "windows", "linux"],
  "runtime": {
    "type": "python",
    "version": ">=3.9",
    "packages": [],
    "note": "Standard library only. The heard words come from the project's transcript (transcript.generate in a Whisper build, or words imported with transcript.set) or from an outside transcriber's JSON."
  },
  "entry": {
    "command": ["python3", "plugin.py"],
    "windows": ["py", "-3", "plugin.py"]
  },
  "connect": {
    "project": ["--project", "{project}"],
    "bridge": ["--bridge", "{address}"],
    "cli": ["--cli", "{cli}"]
  },
  "output": "bashcut-result/1",
  "app": {
    "minVersion": "0.9.0",
    "connections": ["mcp-headless", "mcp-bridge"],
    "tools": ["command_run", "command_batch", "sequence_inspect"],
    "commands": ["transcript.inspect", "transcript.set", "captions.import", "file.save"],
    "effects": []
  },
  "settings": [],
  "actions": [
    {
      "id": "align",
      "title": "Align a script or subtitles to the speech…",
      "args": ["align"],
      "needs": "project",
      "edits": true,
      "params": [
        {"id": "script", "title": "Script or subtitle file", "flag": "--script", "type": "path", "i18n": {"vi": {"title": "Tệp kịch bản hoặc phụ đề"}}},
        {"id": "words", "title": "Heard words file", "flag": "--words", "type": "path", "optional": true, "i18n": {"vi": {"title": "Tệp từ nghe được"}}},
        {"id": "item", "title": "Media item of the words", "flag": "--item", "type": "integer", "optional": true, "i18n": {"vi": {"title": "Tư liệu chứa các từ"}}},
        {"id": "lang", "title": "Language", "flag": "--lang", "type": "string", "optional": true, "i18n": {"vi": {"title": "Ngôn ngữ"}}},
        {"id": "to", "title": "Write to", "flag": "--to", "type": "enum", "choices": ["both", "transcript", "captions", "none"], "default": "both", "i18n": {"vi": {"title": "Ghi vào", "choices": {"both": "Cả hai", "transcript": "Bản chép lời", "captions": "Phụ đề", "none": "Không ghi"}}}},
        {"id": "captionName", "title": "Caption track name", "flag": "--caption-name", "type": "string", "default": "Aligned", "i18n": {"vi": {"title": "Tên track phụ đề"}}},
        {"id": "low", "title": "Low-confidence threshold", "flag": "--low", "type": "number", "default": 0.5, "i18n": {"vi": {"title": "Ngưỡng kém tin cậy"}}},
        {"id": "out", "title": "Output folder", "flag": "--out", "type": "path", "optional": true, "i18n": {"vi": {"title": "Thư mục xuất"}}},
        {"id": "dryRun", "title": "Files only, no changes", "flag": "--dry-run", "type": "bool", "default": false, "i18n": {"vi": {"title": "Chỉ tạo tệp, không sửa dự án"}}}
      ],
      "i18n": {"vi": {"title": "Khớp kịch bản hoặc phụ đề với lời nói…"}}
    },
    {
      "id": "check",
      "title": "Check a script against its time…",
      "args": ["check"],
      "needs": "none",
      "edits": false,
      "params": [
        {"id": "script", "title": "Script or subtitle file", "flag": "--script", "type": "path", "i18n": {"vi": {"title": "Tệp kịch bản hoặc phụ đề"}}},
        {"id": "lang", "title": "Language", "flag": "--lang", "type": "string", "optional": true, "i18n": {"vi": {"title": "Ngôn ngữ"}}},
        {"id": "rate", "title": "Speaking rate (units a second)", "flag": "--rate", "type": "number", "optional": true, "i18n": {"vi": {"title": "Tốc độ nói (đơn vị mỗi giây)"}}},
        {"id": "rateFrom", "title": "Measure rate from words file", "flag": "--rate-from", "type": "path", "optional": true, "i18n": {"vi": {"title": "Đo tốc độ từ tệp từ"}}},
        {"id": "windows", "title": "Narration windows file", "flag": "--windows", "type": "path", "optional": true, "i18n": {"vi": {"title": "Tệp khung lời dẫn"}}},
        {"id": "seconds", "title": "Time for the whole script (s)", "flag": "--seconds", "type": "number", "optional": true, "i18n": {"vi": {"title": "Thời lượng cả kịch bản (giây)"}}},
        {"id": "margin", "title": "Free share of each window", "flag": "--margin", "type": "number", "default": 0.0, "i18n": {"vi": {"title": "Phần trống của mỗi khung"}}}
      ],
      "i18n": {"vi": {"title": "Kiểm tra kịch bản với thời lượng…"}}
    }
  ],
  "skills": ["skills/align/SKILL.md"],
  "i18n": {"vi": {"name": "Khớp kịch bản với lời nói", "summary": "Khớp kịch bản, tệp phụ đề hoặc bản dịch có sẵn vào lời nói theo thời gian từng từ (phụ đề tốt hơn chỉ chép lời), báo các đoạn kém tin cậy, và kiểm tra các câu của kịch bản có vừa thời lượng không."}}
}
