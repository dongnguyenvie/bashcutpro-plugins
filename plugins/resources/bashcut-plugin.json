{
  "schema": "bashcut-plugin/1",
  "id": "bashcut.resources",
  "name": "Online Resources",
  "version": "0.2.19",
  "summary": "Fetch open music, sound effects, stock photos and video, emoji, logos, illustrations, Lottie, fonts and LUTs from official APIs, with each file's licence recorded next to it, then import and place them; credit lines only when asked.",
  "publisher": "dongnguyenvie",
  "license": "MIT",
  "homepage": "https://github.com/dongnguyenvie/bashcutpro-plugins/tree/main/plugins/resources",
  "category": "resources",
  "platforms": ["macos", "windows", "linux"],
  "runtime": {
    "type": "python",
    "version": ">=3.9",
    "packages": ["pillow>=10.1", "numpy>=1.26", "fonttools>=4.40", "resvg-py>=0.5", "rlottie-python>=1.3"],
    "note": "Searching and downloading need only the standard library; contact sheets, PNG rendering, font measuring and LUT measuring need the packages, installed by `setup` into a private environment. Some scripts call curl (shipped with macOS, Windows 10+ and most Linux)."
  },
  "entry": {
    "command": ["python3", "plugin.py"],
    "windows": ["py", "-3", "plugin.py"]
  },
  "connect": {
    "project": ["--project", "{project}"],
    "bridge": ["--bridge", "{address}"],
    "cli": ["--cli", "{cli}"]
  },
  "output": "bashcut-result/1",
  "app": {
    "minVersion": "0.9.0",
    "connections": ["mcp-headless", "mcp-bridge"],
    "tools": ["media_import", "command_run", "sequence_inspect"],
    "commands": ["file.import", "sequence.addTracks", "timeline.place", "project.notes", "project.setNotes", "file.save"],
    "effects": []
  },
  "settings": [
    {
      "id": "pixabayKey",
      "title": "Pixabay API key",
      "type": "secret",
      "env": ["PIXABAY_API_KEY"],
      "optional": true,
      "help": "Free key from pixabay.com/api/docs: adds Pixabay photos and video to stock fetches.",
      "i18n": {"vi": {"title": "Khóa API Pixabay", "help": "Khóa miễn phí từ pixabay.com/api/docs: thêm ảnh và video Pixabay khi tải stock."}}
    },
    {
      "id": "pexelsKey",
      "title": "Pexels API key",
      "type": "secret",
      "env": ["PEXELS_API_KEY"],
      "optional": true,
      "help": "Free key from pexels.com/api: adds Pexels photos and video to stock fetches.",
      "i18n": {"vi": {"title": "Khóa API Pexels", "help": "Khóa miễn phí từ pexels.com/api: thêm ảnh và video Pexels khi tải stock."}}
    },
    {
      "id": "freesoundKey",
      "title": "Freesound API key",
      "type": "secret",
      "env": ["FREESOUND_API_KEY"],
      "optional": true,
      "help": "Free key from freesound.org/apiv2/apply: sound effects come from Freesound (else from Openverse).",
      "i18n": {"vi": {"title": "Khóa API Freesound", "help": "Khóa miễn phí từ freesound.org/apiv2/apply: hiệu ứng âm thanh lấy từ Freesound (nếu không thì từ Openverse)."}}
    }
  ],
  "actions": [
    {
      "id": "scripts",
      "title": "List the fetch scripts",
      "args": ["scripts"],
      "needs": "none",
      "edits": false,
      "params": [],
      "i18n": {"vi": {"title": "Liệt kê các script tải"}}
    },
    {
      "id": "setup",
      "title": "Install the image packages…",
      "args": ["setup"],
      "needs": "none",
      "edits": false,
      "params": [
        {"id": "dryRun", "title": "Only show the steps", "flag": "--dry-run", "type": "bool", "default": false, "i18n": {"vi": {"title": "Chỉ hiện các bước"}}}
      ],
      "i18n": {"vi": {"title": "Cài các gói xử lý ảnh…"}}
    },
    {
      "id": "fetch",
      "title": "Fetch resources…",
      "args": ["fetch"],
      "needs": "project",
      "edits": true,
      "params": [
        {"id": "script", "title": "Script", "flag": "--script", "type": "enum",
         "choices": ["audio", "emoji", "facts", "font", "fonts", "illustrations", "logos", "lottie", "luts", "stock"], "default": "stock", "i18n": {"vi": {"title": "Script", "choices": {"audio": "Âm thanh", "emoji": "Emoji", "facts": "Dữ kiện", "font": "Phông chữ", "fonts": "Bộ phông chữ", "illustrations": "Hình minh họa", "logos": "Logo", "lottie": "Lottie", "luts": "LUT", "stock": "Ảnh và video stock"}}}},
        {"id": "args", "title": "Script options", "flag": "--args", "type": "string", "default": "", "i18n": {"vi": {"title": "Tùy chọn script"}}},
        {"id": "import", "title": "Import into the project", "flag": "--import", "type": "bool", "default": false, "i18n": {"vi": {"title": "Nhập vào dự án"}}},
        {"id": "videoTrack", "title": "Video track", "flag": "--video-track", "type": "string", "default": "V2", "i18n": {"vi": {"title": "Track video"}}},
        {"id": "audioTrack", "title": "Audio track", "flag": "--audio-track", "type": "string", "default": "A2", "i18n": {"vi": {"title": "Track âm thanh"}}},
        {"id": "credits", "title": "Credit in project notes", "flag": "--credits", "type": "bool", "default": false, "i18n": {"vi": {"title": "Ghi nguồn trong ghi chú dự án"}}}
      ],
      "i18n": {"vi": {"title": "Tải tài nguyên…"}}
    },
    {
      "id": "import",
      "title": "Import fetched files",
      "args": ["import"],
      "needs": "project",
      "edits": true,
      "params": [
        {"id": "path", "title": "Files", "flag": "--path", "type": "path", "optional": true, "i18n": {"vi": {"title": "Tệp"}}},
        {"id": "folder", "title": "Folder", "flag": "--folder", "type": "path", "optional": true, "i18n": {"vi": {"title": "Thư mục"}}},
        {"id": "frame", "title": "Place at frame", "flag": "--frame", "type": "integer", "optional": true, "i18n": {"vi": {"title": "Đặt tại khung hình"}}},
        {"id": "duration", "title": "Length (frames)", "flag": "--duration", "type": "integer", "optional": true, "i18n": {"vi": {"title": "Độ dài (khung hình)"}}},
        {"id": "credits", "title": "Credit in project notes", "flag": "--credits", "type": "bool", "default": false, "i18n": {"vi": {"title": "Ghi nguồn trong ghi chú dự án"}}}
      ],
      "i18n": {"vi": {"title": "Nhập các tệp đã tải"}}
    },
    {
      "id": "search",
      "title": "Search open media…",
      "args": ["search"],
      "needs": "none",
      "edits": false,
      "params": [
        {"id": "kind", "title": "Kind", "flag": "--kind", "type": "enum", "choices": ["music", "sfx", "photo", "video", "icon", "font"], "default": "music", "i18n": {"vi": {"title": "Loại", "choices": {"music": "Nhạc", "sfx": "Hiệu ứng âm thanh", "photo": "Ảnh", "video": "Video", "icon": "Biểu tượng", "font": "Phông chữ"}}}},
        {"id": "query", "title": "Search for", "flag": "--query", "type": "string", "i18n": {"vi": {"title": "Tìm"}}},
        {"id": "count", "title": "Results", "flag": "--count", "type": "integer", "default": 12, "minimum": 1, "maximum": 40, "i18n": {"vi": {"title": "Số kết quả"}}},
        {"id": "safeLicence", "title": "CC0 / CC BY / CC BY-SA only", "flag": "--safe-licence", "type": "bool", "default": false, "i18n": {"vi": {"title": "Chỉ CC0 / CC BY / CC BY-SA"}}}
      ],
      "i18n": {"vi": {"title": "Tìm tư liệu mở…"}}
    },
    {
      "id": "download",
      "title": "Download a search result",
      "args": ["download"],
      "needs": "none",
      "edits": false,
      "params": [
        {"id": "kind", "title": "Kind", "flag": "--kind", "type": "enum", "choices": ["music", "sfx", "photo", "video", "icon", "font"], "default": "music", "i18n": {"vi": {"title": "Loại", "choices": {"music": "Nhạc", "sfx": "Hiệu ứng âm thanh", "photo": "Ảnh", "video": "Video", "icon": "Biểu tượng", "font": "Phông chữ"}}}},
        {"id": "url", "title": "File URL", "flag": "--url", "type": "string", "i18n": {"vi": {"title": "URL tệp"}}},
        {"id": "title", "title": "Title", "flag": "--title", "type": "string", "default": "", "i18n": {"vi": {"title": "Tiêu đề"}}},
        {"id": "license", "title": "Licence", "flag": "--license", "type": "string", "default": "", "i18n": {"vi": {"title": "Giấy phép"}}},
        {"id": "author", "title": "Author", "flag": "--author", "type": "string", "default": "", "i18n": {"vi": {"title": "Tác giả"}}},
        {"id": "source", "title": "Source page", "flag": "--source", "type": "string", "default": "", "i18n": {"vi": {"title": "Trang nguồn"}}}
      ],
      "i18n": {"vi": {"title": "Tải một kết quả tìm kiếm"}}
    },
    {
      "id": "credits",
      "title": "Credits of a folder",
      "args": ["credits"],
      "needs": "none",
      "edits": false,
      "params": [
        {"id": "folder", "title": "Folder", "flag": "--folder", "type": "path", "i18n": {"vi": {"title": "Thư mục"}}}
      ],
      "i18n": {"vi": {"title": "Ghi nguồn của một thư mục"}}
    }
  ],
  "models": ["rawtherapee-haldclut"],
  "skills": ["skills/resources/SKILL.md"],
  "i18n": {"vi": {"name": "Tài nguyên trực tuyến", "summary": "Tải nhạc, hiệu ứng âm thanh, ảnh và video stock, emoji, logo, hình minh họa, Lottie, phông chữ và LUT mở từ API chính thức, ghi giấy phép cạnh từng tệp, rồi nhập và đặt vào dự án; chỉ ghi nguồn khi được yêu cầu."}}
}
