{
  "schema": "bashcut-plugin/1",
  "id": "bashcut.library",
  "name": "Library",
  "version": "0.1.14",
  "summary": "One place for reusable looks, titles, text styles, stickers, overlays, sounds, music beds, effect presets, project templates and brand kits: save them from a project, search them, apply them to another, share them as packs.",
  "publisher": "dongnguyenvie",
  "license": "MIT",
  "homepage": "https://github.com/dongnguyenvie/bashcutpro-plugins/tree/main/plugins/library",
  "category": "library",
  "platforms": [
    "macos",
    "windows",
    "linux"
  ],
  "runtime": {
    "type": "python",
    "version": ">=3.9",
    "packages": []
  },
  "entry": {
    "command": [
      "python3",
      "plugin.py"
    ],
    "windows": [
      "py",
      "-3",
      "plugin.py"
    ]
  },
  "connect": {
    "project": [
      "--project",
      "{project}"
    ],
    "bridge": [
      "--bridge",
      "{address}"
    ],
    "cli": [
      "--cli",
      "{cli}"
    ]
  },
  "output": "bashcut-result/1",
  "app": {
    "minVersion": "0.9.0",
    "connections": [
      "mcp-headless",
      "mcp-bridge"
    ],
    "tools": [
      "command_run",
      "media_import",
      "sequence_inspect"
    ],
    "commands": [
      "graphics.template.export",
      "graphics.template.apply",
      "presets.save",
      "presets.export",
      "presets.import",
      "presets.apply",
      "lut.export",
      "lumetri.setLook",
      "file.exportMedia",
      "sequence.addTracks",
      "timeline.place",
      "captions.setStyle",
      "file.save"
    ],
    "effects": []
  },
  "settings": [
    {
      "id": "libraryDir",
      "title": "Library folder",
      "type": "path",
      "env": [
        "BASHCUT_LIBRARY_DIR"
      ],
      "flag": "--library-dir",
      "optional": true,
      "help": "Where the index and files live (default <data dir>/bashcut/library).",
      "i18n": {"vi": {"title": "Thư mục thư viện", "help": "Nơi lưu chỉ mục và các tệp (mặc định <data dir>/bashcut/library)."}}
    }
  ],
  "actions": [
    {
      "id": "search",
      "title": "Search the library…",
      "args": [
        "search"
      ],
      "needs": "none",
      "edits": false,
      "params": [
        {
          "id": "query",
          "title": "Words",
          "flag": "--query",
          "type": "string",
          "default": "",
          "i18n": {"vi": {"title": "Từ khóa"}}
        },
        {
          "id": "kind",
          "title": "Kind",
          "flag": "--kind",
          "type": "enum",
          "choices": [
            "",
            "brand-kit",
            "effect-preset",
            "look",
            "lut",
            "music",
            "overlay",
            "sound",
            "sticker",
            "template",
            "text-style",
            "title"
          ],
          "default": "",
          "i18n": {"vi": {"title": "Loại", "choices": {"": "Tất cả", "brand-kit": "Bộ nhận diện thương hiệu", "effect-preset": "Preset hiệu ứng", "look": "Màu phim", "lut": "LUT", "music": "Nhạc", "overlay": "Lớp phủ", "sound": "Âm thanh", "sticker": "Sticker", "template": "Mẫu dự án", "text-style": "Kiểu chữ", "title": "Tiêu đề"}}}
        },
        {
          "id": "tags",
          "title": "Tags",
          "flag": "--tags",
          "type": "string",
          "default": "",
          "i18n": {"vi": {"title": "Thẻ"}}
        },
        {
          "id": "favourites",
          "title": "Favourites only",
          "flag": "--favourites",
          "type": "bool",
          "default": false,
          "i18n": {"vi": {"title": "Chỉ mục yêu thích"}}
        }
      ],
      "i18n": {"vi": {"title": "Tìm trong thư viện…"}}
    },
    {
      "id": "add",
      "title": "Add a file…",
      "args": [
        "add"
      ],
      "needs": "none",
      "edits": false,
      "params": [
        {
          "id": "kind",
          "title": "Kind",
          "flag": "--kind",
          "type": "enum",
          "choices": [
            "brand-kit",
            "effect-preset",
            "look",
            "lut",
            "music",
            "overlay",
            "sound",
            "sticker",
            "template",
            "text-style",
            "title"
          ],
          "default": "sticker",
          "i18n": {"vi": {"title": "Loại", "choices": {"brand-kit": "Bộ nhận diện thương hiệu", "effect-preset": "Preset hiệu ứng", "look": "Màu phim", "lut": "LUT", "music": "Nhạc", "overlay": "Lớp phủ", "sound": "Âm thanh", "sticker": "Sticker", "template": "Mẫu dự án", "text-style": "Kiểu chữ", "title": "Tiêu đề"}}}
        },
        {
          "id": "file",
          "title": "File",
          "flag": "--file",
          "type": "path",
          "i18n": {"vi": {"title": "Tệp"}}
        },
        {
          "id": "title",
          "title": "Title",
          "flag": "--title",
          "type": "string",
          "i18n": {"vi": {"title": "Tiêu đề"}}
        },
        {
          "id": "purpose",
          "title": "Purpose",
          "flag": "--purpose",
          "type": "string",
          "default": "",
          "i18n": {"vi": {"title": "Mục đích"}}
        },
        {
          "id": "tags",
          "title": "Tags",
          "flag": "--tags",
          "type": "string",
          "default": "",
          "i18n": {"vi": {"title": "Thẻ"}}
        },
        {
          "id": "license",
          "title": "Licence",
          "flag": "--license",
          "type": "string",
          "default": "",
          "i18n": {"vi": {"title": "Giấy phép"}}
        },
        {
          "id": "preview",
          "title": "Preview",
          "flag": "--preview",
          "type": "path",
          "optional": true,
          "i18n": {"vi": {"title": "Xem trước"}}
        }
      ],
      "i18n": {"vi": {"title": "Thêm tệp…"}}
    },
    {
      "id": "save",
      "title": "Save the selection…",
      "args": [
        "save"
      ],
      "needs": "project",
      "edits": false,
      "params": [
        {
          "id": "kind",
          "title": "Kind",
          "flag": "--kind",
          "type": "enum",
          "choices": [
            "effect-preset",
            "look",
            "lut",
            "music",
            "overlay",
            "sound",
            "sticker",
            "text-style",
            "title"
          ],
          "default": "title",
          "i18n": {"vi": {"title": "Loại", "choices": {"effect-preset": "Preset hiệu ứng", "look": "Màu phim", "lut": "LUT", "music": "Nhạc", "overlay": "Lớp phủ", "sound": "Âm thanh", "sticker": "Sticker", "text-style": "Kiểu chữ", "title": "Tiêu đề"}}}
        },
        {
          "id": "clip",
          "title": "Clip (default: the selection)",
          "flag": "--clip",
          "type": "integer",
          "optional": true,
          "i18n": {"vi": {"title": "Clip (mặc định: vùng chọn)"}}
        },
        {
          "id": "lut",
          "title": "LUT",
          "flag": "--lut",
          "type": "string",
          "optional": true,
          "i18n": {"vi": {"title": "LUT"}}
        },
        {
          "id": "start",
          "title": "Range start (s)",
          "flag": "--start",
          "type": "number",
          "optional": true,
          "i18n": {"vi": {"title": "Đầu đoạn (giây)"}}
        },
        {
          "id": "end",
          "title": "Range end (s)",
          "flag": "--end",
          "type": "number",
          "optional": true,
          "i18n": {"vi": {"title": "Cuối đoạn (giây)"}}
        },
        {
          "id": "title",
          "title": "Title",
          "flag": "--title",
          "type": "string",
          "i18n": {"vi": {"title": "Tiêu đề"}}
        },
        {
          "id": "purpose",
          "title": "Purpose",
          "flag": "--purpose",
          "type": "string",
          "default": "",
          "i18n": {"vi": {"title": "Mục đích"}}
        },
        {
          "id": "tags",
          "title": "Tags",
          "flag": "--tags",
          "type": "string",
          "default": "",
          "i18n": {"vi": {"title": "Thẻ"}}
        },
        {
          "id": "license",
          "title": "Licence",
          "flag": "--license",
          "type": "string",
          "default": "",
          "i18n": {"vi": {"title": "Giấy phép"}}
        },
        {
          "id": "preview",
          "title": "Preview",
          "flag": "--preview",
          "type": "path",
          "optional": true,
          "i18n": {"vi": {"title": "Xem trước"}}
        }
      ],
      "i18n": {"vi": {"title": "Lưu vùng chọn…"}}
    },
    {
      "id": "apply",
      "title": "Apply or place an item",
      "args": [
        "apply"
      ],
      "needs": "project",
      "edits": true,
      "params": [
        {
          "id": "id",
          "title": "Item",
          "flag": "--id",
          "type": "string",
          "i18n": {"vi": {"title": "Mục"}}
        },
        {
          "id": "out",
          "title": "New project (templates)",
          "flag": "--out",
          "type": "path",
          "optional": true,
          "i18n": {"vi": {"title": "Dự án mới (mẫu)"}}
        },
        {
          "id": "clip",
          "title": "Clips (default: the selection)",
          "flag": "--clip",
          "type": "string",
          "optional": true,
          "i18n": {"vi": {"title": "Các clip (mặc định: vùng chọn)"}}
        },
        {
          "id": "seconds",
          "title": "Start (s)",
          "flag": "--seconds",
          "type": "number",
          "optional": true,
          "i18n": {"vi": {"title": "Bắt đầu (giây)"}}
        },
        {
          "id": "track",
          "title": "Track",
          "flag": "--track",
          "type": "string",
          "optional": true,
          "i18n": {"vi": {"title": "Track"}}
        },
        {
          "id": "values",
          "title": "Title values (JSON)",
          "flag": "--values",
          "type": "string",
          "optional": true,
          "i18n": {"vi": {"title": "Giá trị tiêu đề (JSON)"}}
        }
      ],
      "i18n": {"vi": {"title": "Áp dụng hoặc đặt một mục"}}
    },
    {
      "id": "favourite",
      "title": "Favourite",
      "args": [
        "favourite"
      ],
      "needs": "none",
      "edits": false,
      "params": [
        {
          "id": "id",
          "title": "Item",
          "flag": "--id",
          "type": "string",
          "i18n": {"vi": {"title": "Mục"}}
        },
        {
          "id": "off",
          "title": "Remove from favourites",
          "flag": "--off",
          "type": "bool",
          "default": false,
          "i18n": {"vi": {"title": "Bỏ khỏi yêu thích"}}
        }
      ],
      "i18n": {"vi": {"title": "Yêu thích"}}
    },
    {
      "id": "remove",
      "title": "Remove an item",
      "args": [
        "remove"
      ],
      "needs": "none",
      "edits": false,
      "params": [
        {
          "id": "id",
          "title": "Item",
          "flag": "--id",
          "type": "string",
          "i18n": {"vi": {"title": "Mục"}}
        }
      ],
      "i18n": {"vi": {"title": "Xóa một mục"}}
    },
    {
      "id": "packExport",
      "title": "Export a pack…",
      "args": [
        "pack-export"
      ],
      "needs": "none",
      "edits": false,
      "params": [
        {
          "id": "out",
          "title": "Pack file",
          "flag": "--out",
          "type": "path",
          "i18n": {"vi": {"title": "Tệp gói"}}
        },
        {
          "id": "kind",
          "title": "Kind",
          "flag": "--kind",
          "type": "enum",
          "choices": [
            "",
            "brand-kit",
            "effect-preset",
            "look",
            "lut",
            "music",
            "overlay",
            "sound",
            "sticker",
            "template",
            "text-style",
            "title"
          ],
          "default": "",
          "i18n": {"vi": {"title": "Loại", "choices": {"": "Tất cả", "brand-kit": "Bộ nhận diện thương hiệu", "effect-preset": "Preset hiệu ứng", "look": "Màu phim", "lut": "LUT", "music": "Nhạc", "overlay": "Lớp phủ", "sound": "Âm thanh", "sticker": "Sticker", "template": "Mẫu dự án", "text-style": "Kiểu chữ", "title": "Tiêu đề"}}}
        },
        {
          "id": "tags",
          "title": "Tags",
          "flag": "--tags",
          "type": "string",
          "default": "",
          "i18n": {"vi": {"title": "Thẻ"}}
        }
      ],
      "i18n": {"vi": {"title": "Xuất gói…"}}
    },
    {
      "id": "packImport",
      "title": "Import a pack…",
      "args": [
        "pack-import"
      ],
      "needs": "none",
      "edits": false,
      "params": [
        {
          "id": "path",
          "title": "Pack file",
          "flag": "--path",
          "type": "path",
          "i18n": {"vi": {"title": "Tệp gói"}}
        }
      ],
      "i18n": {"vi": {"title": "Nhập gói…"}}
    },
    {
      "id": "stats",
      "title": "Library stats",
      "args": [
        "stats"
      ],
      "needs": "none",
      "edits": false,
      "params": [],
      "i18n": {"vi": {"title": "Thống kê thư viện"}}
    },
    {
      "id": "brandShow",
      "title": "Show a brand kit",
      "args": [
        "brand",
        "show"
      ],
      "needs": "none",
      "edits": false,
      "params": [
        {
          "id": "id",
          "title": "Brand kit",
          "flag": "--id",
          "type": "string",
          "i18n": {"vi": {"title": "Bộ nhận diện thương hiệu"}}
        }
      ],
      "i18n": {"vi": {"title": "Xem bộ nhận diện thương hiệu"}}
    },
    {
      "id": "brandApply",
      "title": "Apply a brand kit part",
      "args": [
        "brand",
        "apply"
      ],
      "needs": "project",
      "edits": true,
      "params": [
        {
          "id": "id",
          "title": "Brand kit",
          "flag": "--id",
          "type": "string",
          "i18n": {"vi": {"title": "Bộ nhận diện thương hiệu"}}
        },
        {
          "id": "part",
          "title": "Part",
          "flag": "--part",
          "type": "enum",
          "choices": [
            "logo",
            "intro",
            "outro",
            "lowerThird",
            "captionStyle"
          ],
          "default": "lowerThird",
          "i18n": {"vi": {"title": "Phần", "choices": {"logo": "Logo", "intro": "Đoạn mở đầu", "outro": "Đoạn kết", "lowerThird": "Chữ chân màn hình", "captionStyle": "Kiểu phụ đề"}}}
        },
        {
          "id": "seconds",
          "title": "Start (s)",
          "flag": "--seconds",
          "type": "number",
          "optional": true,
          "i18n": {"vi": {"title": "Bắt đầu (giây)"}}
        }
      ],
      "i18n": {"vi": {"title": "Áp dụng một phần bộ nhận diện"}}
    }
  ],
  "skills": [
    "skills/library-plugin/SKILL.md"
  ],
  "i18n": {"vi": {"name": "Thư viện", "summary": "Một nơi cho màu phim, tiêu đề, kiểu chữ, sticker, lớp phủ, âm thanh, nhạc nền, preset hiệu ứng, mẫu dự án và bộ nhận diện thương hiệu dùng lại được: lưu từ dự án, tìm kiếm, áp dụng cho dự án khác, chia sẻ thành gói."}}
}
