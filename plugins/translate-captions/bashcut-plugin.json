{
  "schema": "bashcut-plugin/1",
  "id": "bashcut.translate-captions",
  "name": "Translate Captions",
  "version": "0.1.19",
  "summary": "Translate a sequence's captions with your own Gemini or OpenAI key (or your agent) while keeping their timing, and blur subtitles burned into the footage.",
  "publisher": "dongnguyenvie",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/dongnguyenvie/bashcutpro-plugins/tree/main/plugins/translate-captions",
  "category": "captions",
  "platforms": ["macos", "windows", "linux"],
  "runtime": {
    "type": "python",
    "version": ">=3.9",
    "packages": []
  },
  "entry": {
    "command": ["python3", "plugin.py"],
    "windows": ["py", "-3", "plugin.py"]
  },
  "connect": {
    "project": ["--project", "{project}"],
    "bridge": ["--bridge", "{address}"],
    "cli": ["--cli", "{cli}"]
  },
  "output": "bashcut-result/1",
  "app": {
    "minVersion": "0.9.0",
    "connections": ["mcp-headless", "mcp-bridge"],
    "tools": ["command_run", "command_batch", "sequence_inspect"],
    "commands": [
      "captions.list",
      "captions.setText",
      "captions.setTrack",
      "file.exportFrame",
      "file.save",
      "effects.apply",
      "effects.setParam",
      "effects.remove",
      "masks.add",
      "masks.set",
      "masks.list"
    ],
    "effects": ["gaussian_blur", "mosaic"]
  },
  "settings": [
    {
      "id": "service",
      "title": "Service",
      "type": "enum",
      "choices": ["gemini", "openai"],
      "default": "gemini",
      "env": ["BASHCUT_TC_SERVICE"],
      "flag": "--service",
      "help": "Who translates. The key is sent only to this service.",
      "i18n": {"vi": {"title": "Dịch vụ", "help": "Bên dịch. Khóa chỉ được gửi tới dịch vụ này.", "choices": {"gemini": "Gemini", "openai": "OpenAI"}}}
    },
    {
      "id": "apiKey",
      "title": "API key",
      "type": "secret",
      "env": ["BASHCUT_TC_API_KEY", "GEMINI_API_KEY", "GOOGLE_API_KEY", "OPENAI_API_KEY"],
      "flag": "--api-key",
      "optional": true,
      "help": "Your Gemini or OpenAI key. Without a key, the agent translates the lines for you.",
      "i18n": {"vi": {"title": "Khóa API", "help": "Khóa Gemini hoặc OpenAI của bạn. Không có khóa thì agent sẽ dịch giúp bạn."}}
    },
    {
      "id": "model",
      "title": "Model",
      "type": "string",
      "default": "auto",
      "env": ["BASHCUT_TC_MODEL"],
      "flag": "--model",
      "help": "auto = gemini-flash-lite-latest (Gemini) or gpt-5-mini (OpenAI); or any model id of the service.",
      "i18n": {"vi": {"title": "Mô hình", "help": "auto = gemini-flash-lite-latest (Gemini) hoặc gpt-5-mini (OpenAI); hoặc mã bất kỳ mô hình nào của dịch vụ."}}
    },
    {
      "id": "endpoint",
      "title": "Endpoint",
      "type": "string",
      "default": "",
      "env": ["BASHCUT_TC_ENDPOINT"],
      "flag": "--endpoint",
      "help": "An OpenAI-compatible server instead of the service's own address; one on this machine needs no key.",
      "i18n": {"vi": {"title": "Địa chỉ máy chủ", "help": "Máy chủ tương thích OpenAI thay cho địa chỉ của dịch vụ; máy chủ trên máy này không cần khóa."}}
    }
  ],
  "actions": [
    {
      "id": "translate",
      "title": "Translate captions…",
      "args": ["translate"],
      "view": true,
      "needs": "project",
      "edits": true,
      "params": [
        {"id": "target", "title": "Language", "flag": "--target", "type": "enum", "default": "vi",
         "choices": ["vi", "en", "zh", "ja", "ko", "th", "id", "es", "fr", "de", "pt", "ru"], "i18n": {"vi": {"title": "Ngôn ngữ", "choices": {"vi": "Tiếng Việt", "en": "Tiếng Anh", "zh": "Tiếng Trung", "ja": "Tiếng Nhật", "ko": "Tiếng Hàn", "th": "Tiếng Thái", "id": "Tiếng Indonesia", "es": "Tiếng Tây Ban Nha", "fr": "Tiếng Pháp", "de": "Tiếng Đức", "pt": "Tiếng Bồ Đào Nha", "ru": "Tiếng Nga"}}}},
        {"id": "track", "title": "Caption track", "flag": "--track", "type": "string", "optional": true, "i18n": {"vi": {"title": "Track phụ đề"}}},
        {"id": "glossary", "title": "Glossary", "flag": "--glossary", "type": "string", "default": "", "i18n": {"vi": {"title": "Bảng thuật ngữ"}}},
        {"id": "tone", "title": "Tone", "flag": "--tone", "type": "enum", "choices": ["natural", "casual", "formal"], "default": "natural", "i18n": {"vi": {"title": "Giọng văn", "choices": {"natural": "Tự nhiên", "casual": "Thân mật", "formal": "Trang trọng"}}}},
        {"id": "maxCps", "title": "Max characters a second", "flag": "--max-cps", "type": "integer", "minimum": 8, "maximum": 30, "default": 17, "i18n": {"vi": {"title": "Số ký tự tối đa mỗi giây"}}},
        {"id": "brief", "title": "Brief", "flag": "--brief", "type": "string", "default": "", "i18n": {"vi": {"title": "Yêu cầu thêm"}}}
      ],
      "handoff": {"exit": 3, "then": "apply"},
      "i18n": {"vi": {"title": "Dịch phụ đề…"}}
    },
    {
      "id": "review",
      "title": "Review captions…",
      "args": ["review"],
      "view": true,
      "needs": "project",
      "edits": false,
      "params": [
        {"id": "target", "title": "Language", "flag": "--target", "type": "enum", "default": "vi",
         "choices": ["vi", "en", "zh", "ja", "ko", "th", "id", "es", "fr", "de", "pt", "ru"], "i18n": {"vi": {"title": "Ngôn ngữ", "choices": {"vi": "Tiếng Việt", "en": "Tiếng Anh", "zh": "Tiếng Trung", "ja": "Tiếng Nhật", "ko": "Tiếng Hàn", "th": "Tiếng Thái", "id": "Tiếng Indonesia", "es": "Tiếng Tây Ban Nha", "fr": "Tiếng Pháp", "de": "Tiếng Đức", "pt": "Tiếng Bồ Đào Nha", "ru": "Tiếng Nga"}}}},
        {"id": "track", "title": "Caption track", "flag": "--track", "type": "string", "optional": true, "i18n": {"vi": {"title": "Track phụ đề"}}},
        {"id": "glossary", "title": "Glossary", "flag": "--glossary", "type": "string", "default": "", "i18n": {"vi": {"title": "Bảng thuật ngữ"}}},
        {"id": "tone", "title": "Tone", "flag": "--tone", "type": "enum", "choices": ["natural", "casual", "formal"], "default": "natural", "i18n": {"vi": {"title": "Giọng văn", "choices": {"natural": "Tự nhiên", "casual": "Thân mật", "formal": "Trang trọng"}}}}
      ],
      "i18n": {"vi": {"title": "Rà soát phụ đề…"}}
    },
    {
      "id": "export-lines",
      "title": "Export lines for the agent",
      "args": ["export-lines"],
      "needs": "project",
      "edits": false,
      "params": [
        {"id": "target", "title": "Language", "flag": "--target", "type": "enum", "default": "vi",
         "choices": ["vi", "en", "zh", "ja", "ko", "th", "id", "es", "fr", "de", "pt", "ru"], "i18n": {"vi": {"title": "Ngôn ngữ", "choices": {"vi": "Tiếng Việt", "en": "Tiếng Anh", "zh": "Tiếng Trung", "ja": "Tiếng Nhật", "ko": "Tiếng Hàn", "th": "Tiếng Thái", "id": "Tiếng Indonesia", "es": "Tiếng Tây Ban Nha", "fr": "Tiếng Pháp", "de": "Tiếng Đức", "pt": "Tiếng Bồ Đào Nha", "ru": "Tiếng Nga"}}}},
        {"id": "track", "title": "Caption track", "flag": "--track", "type": "string", "optional": true, "i18n": {"vi": {"title": "Track phụ đề"}}},
        {"id": "maxCps", "title": "Max characters a second", "flag": "--max-cps", "type": "integer", "minimum": 8, "maximum": 30, "default": 17, "i18n": {"vi": {"title": "Số ký tự tối đa mỗi giây"}}}
      ],
      "i18n": {"vi": {"title": "Xuất các câu cho agent"}}
    },
    {
      "id": "apply",
      "title": "Apply the agent's translations",
      "args": ["apply"],
      "needs": "project",
      "edits": true,
      "params": [
        {"id": "answer", "title": "Translations file", "flag": "--answer", "type": "path", "i18n": {"vi": {"title": "Tệp bản dịch"}}},
        {"id": "lines", "title": "Exported lines file", "flag": "--lines", "type": "path", "optional": true, "i18n": {"vi": {"title": "Tệp các câu đã xuất"}}},
        {"id": "target", "title": "Language", "flag": "--target", "type": "string", "optional": true, "i18n": {"vi": {"title": "Ngôn ngữ"}}},
        {"id": "track", "title": "Caption track", "flag": "--track", "type": "string", "optional": true, "i18n": {"vi": {"title": "Track phụ đề"}}}
      ],
      "i18n": {"vi": {"title": "Áp dụng bản dịch của agent"}}
    },
    {
      "id": "cover",
      "title": "Cover burned-in subtitles…",
      "args": ["cover"],
      "needs": "project",
      "edits": true,
      "params": [
        {"id": "mode", "title": "Mode", "flag": "--mode", "type": "enum", "choices": ["blur", "mosaic", "detect"], "default": "blur", "i18n": {"vi": {"title": "Chế độ", "choices": {"blur": "Làm mờ", "mosaic": "Khảm điểm ảnh", "detect": "Chỉ dò tìm"}}}},
        {"id": "box", "title": "Area (x,y,w,h)", "flag": "--box", "type": "string", "optional": true, "i18n": {"vi": {"title": "Vùng (x,y,w,h)"}}},
        {"id": "where", "title": "Where to look", "flag": "--where", "type": "enum", "choices": ["bottom", "top", "any"], "default": "bottom", "i18n": {"vi": {"title": "Vị trí tìm", "choices": {"bottom": "Phía dưới", "top": "Phía trên", "any": "Bất kỳ đâu"}}}},
        {"id": "seconds", "title": "Seconds to look at", "flag": "--seconds", "type": "number", "default": 30, "i18n": {"vi": {"title": "Số giây cần xem"}}},
        {"id": "frames", "title": "Frames per clip", "flag": "--frames", "type": "integer", "default": 8, "i18n": {"vi": {"title": "Số khung hình mỗi clip"}}}
      ],
      "i18n": {"vi": {"title": "Che phụ đề cứng…"}}
    },
    {
      "id": "check-key",
      "title": "Check the API key",
      "args": ["check-key"],
      "needs": "none",
      "edits": false,
      "params": [],
      "i18n": {"vi": {"title": "Kiểm tra khóa API"}}
    }
  ],
  "skills": ["skills/translate-captions/SKILL.md"],
  "i18n": {"vi": {"name": "Dịch phụ đề", "summary": "Dịch phụ đề của sequence bằng khóa Gemini hoặc OpenAI của bạn (hoặc agent của bạn) mà vẫn giữ thời gian, và làm mờ phụ đề cứng có sẵn trong video."}}
}
