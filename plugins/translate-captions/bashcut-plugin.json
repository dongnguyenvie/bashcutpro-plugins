{
  "schema": "bashcut-plugin/1",
  "id": "bashcut.translate-captions",
  "name": "Translate Captions",
  "version": "0.1.0",
  "summary": "Translate a sequence's captions with your own Gemini or OpenAI key (or your agent) while keeping their timing, and blur subtitles burned into the footage.",
  "publisher": "dongnguyenvie",
  "license": "MIT",
  "homepage": "https://github.com/dongnguyenvie/bashcutpro-plugins/tree/main/plugins/translate-captions",
  "category": "captions",
  "platforms": ["macos", "windows", "linux"],
  "runtime": {
    "type": "python",
    "version": ">=3.9",
    "packages": []
  },
  "entry": {
    "command": ["python3", "plugin.py"],
    "windows": ["py", "-3", "plugin.py"]
  },
  "connect": {
    "project": ["--project", "{project}"],
    "bridge": ["--bridge", "{address}"],
    "cli": ["--cli", "{cli}"]
  },
  "output": "bashcut-result/1",
  "app": {
    "minVersion": "0.9.0",
    "connections": ["mcp-headless", "mcp-bridge"],
    "tools": ["command_run", "command_batch", "sequence_inspect"],
    "commands": [
      "captions.list",
      "captions.setText",
      "captions.setTrack",
      "file.exportFrame",
      "file.save",
      "effects.apply",
      "effects.setParam",
      "effects.remove",
      "masks.add",
      "masks.set",
      "masks.list"
    ],
    "effects": ["gaussian_blur", "mosaic"]
  },
  "settings": [
    {
      "id": "service",
      "title": "Service",
      "type": "enum",
      "choices": ["gemini", "openai"],
      "default": "gemini",
      "env": ["BASHCUT_TC_SERVICE"],
      "flag": "--service",
      "help": "Who translates. The key is sent only to this service."
    },
    {
      "id": "apiKey",
      "title": "API key",
      "type": "secret",
      "env": ["BASHCUT_TC_API_KEY", "GEMINI_API_KEY", "GOOGLE_API_KEY", "OPENAI_API_KEY"],
      "flag": "--api-key",
      "optional": true,
      "help": "Your Gemini or OpenAI key. Without one, the calling agent translates (exit status 3 hands it the lines)."
    },
    {
      "id": "model",
      "title": "Model",
      "type": "string",
      "default": "auto",
      "env": ["BASHCUT_TC_MODEL"],
      "flag": "--model",
      "help": "auto = gemini-flash-lite-latest (Gemini) or gpt-5-mini (OpenAI); or any model id of the service."
    },
    {
      "id": "endpoint",
      "title": "Endpoint",
      "type": "string",
      "default": "",
      "env": ["BASHCUT_TC_ENDPOINT"],
      "flag": "--endpoint",
      "help": "An OpenAI-compatible server instead of the service's own address; one on this machine needs no key."
    }
  ],
  "actions": [
    {
      "id": "translate",
      "title": "Translate captions…",
      "args": ["translate"],
      "view": true,
      "needs": "project",
      "edits": true,
      "params": [
        {"id": "target", "flag": "--target", "type": "enum", "default": "vi",
         "choices": ["vi", "en", "zh", "ja", "ko", "th", "id", "es", "fr", "de", "pt", "ru"]},
        {"id": "track", "flag": "--track", "type": "string", "optional": true},
        {"id": "glossary", "flag": "--glossary", "type": "string", "default": ""},
        {"id": "tone", "flag": "--tone", "type": "enum", "choices": ["natural", "casual", "formal"], "default": "natural"},
        {"id": "maxCps", "flag": "--max-cps", "type": "integer", "minimum": 8, "maximum": 30, "default": 17},
        {"id": "brief", "flag": "--brief", "type": "string", "default": ""}
      ],
      "handoff": {"exit": 3, "then": "apply"}
    },
    {
      "id": "review",
      "title": "Review captions…",
      "args": ["review"],
      "view": true,
      "needs": "project",
      "edits": false,
      "params": [
        {"id": "target", "flag": "--target", "type": "enum", "default": "vi",
         "choices": ["vi", "en", "zh", "ja", "ko", "th", "id", "es", "fr", "de", "pt", "ru"]},
        {"id": "track", "flag": "--track", "type": "string", "optional": true},
        {"id": "glossary", "flag": "--glossary", "type": "string", "default": ""},
        {"id": "tone", "flag": "--tone", "type": "enum", "choices": ["natural", "casual", "formal"], "default": "natural"}
      ]
    },
    {
      "id": "export-lines",
      "title": "Export lines for the agent",
      "args": ["export-lines"],
      "needs": "project",
      "edits": false,
      "params": [
        {"id": "target", "flag": "--target", "type": "enum", "default": "vi",
         "choices": ["vi", "en", "zh", "ja", "ko", "th", "id", "es", "fr", "de", "pt", "ru"]},
        {"id": "track", "flag": "--track", "type": "string", "optional": true},
        {"id": "maxCps", "flag": "--max-cps", "type": "integer", "minimum": 8, "maximum": 30, "default": 17}
      ]
    },
    {
      "id": "apply",
      "title": "Apply the agent's translations",
      "args": ["apply"],
      "needs": "project",
      "edits": true,
      "params": [
        {"id": "answer", "flag": "--answer", "type": "path"},
        {"id": "lines", "flag": "--lines", "type": "path", "optional": true},
        {"id": "target", "flag": "--target", "type": "string", "optional": true},
        {"id": "track", "flag": "--track", "type": "string", "optional": true}
      ]
    },
    {
      "id": "cover",
      "title": "Cover burned-in subtitles…",
      "args": ["cover"],
      "needs": "project",
      "edits": true,
      "params": [
        {"id": "mode", "flag": "--mode", "type": "enum", "choices": ["blur", "mosaic", "detect"], "default": "blur"},
        {"id": "box", "flag": "--box", "type": "string", "optional": true},
        {"id": "where", "flag": "--where", "type": "enum", "choices": ["bottom", "top", "any"], "default": "bottom"},
        {"id": "seconds", "flag": "--seconds", "type": "number", "default": 30},
        {"id": "frames", "flag": "--frames", "type": "integer", "default": 8}
      ]
    },
    {
      "id": "check-key",
      "title": "Check the API key",
      "args": ["check-key"],
      "needs": "none",
      "edits": false,
      "params": []
    }
  ],
  "skills": ["skills/translate-captions/SKILL.md"]
}
